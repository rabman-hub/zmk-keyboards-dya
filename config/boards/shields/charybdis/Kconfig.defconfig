# ---------- standalone: RIGHT half is the central ----------
if SHIELD_CHARYBDIS_RIGHT

config ZMK_KEYBOARD_NAME
    default "Charybdis"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

# ---------- dongle: the DONGLE is the central ----------
if SHIELD_CHARYBDIS_CENTRAL_DONGLE

config ZMK_KEYBOARD_NAME
    default "Chary Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

# ---------- split enabled for every variant ----------
if SHIELD_CHARYBDIS_LEFT || SHIELD_CHARYBDIS_RIGHT || \
   SHIELD_CHARYBDIS_CENTRAL_DONGLE || SHIELD_CHARYBDIS_PERIPHERAL_LEFT || \
   SHIELD_CHARYBDIS_PERIPHERAL_RIGHT

config ZMK_SPLIT
    default y

endif

# ---------- OLED on the dongle ----------
if SHIELD_CHARYBDIS_CENTRAL_DONGLE

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # ZMK_DISPLAY

if SSD1306

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # SSD1306

endif # SHIELD_CHARYBDIS_CENTRAL_DONGLE
