# --- standalone (no dongle) ---
config SHIELD_CHARYBDIS_LEFT
    def_bool $(shields_list_contains,charybdis_left)

config SHIELD_CHARYBDIS_RIGHT
    def_bool $(shields_list_contains,charybdis_right)

# --- dongle setup ---
config SHIELD_CHARYBDIS_CENTRAL_DONGLE
    def_bool $(shields_list_contains,charybdis_central_dongle)

config SHIELD_CHARYBDIS_PERIPHERAL_LEFT
    def_bool $(shields_list_contains,charybdis_peripheral_left)

config SHIELD_CHARYBDIS_PERIPHERAL_RIGHT
    def_bool $(shields_list_contains,charybdis_peripheral_right)
