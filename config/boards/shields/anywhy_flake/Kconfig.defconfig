# ---------- standalone: LEFT half is the central ----------
if SHIELD_ANYWHY_FLAKE_LEFT

config ZMK_KEYBOARD_NAME
    default "Anywhy Flake"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_STUDIO
    default y

endif

# ---------- dongle: the DONGLE is the central ----------
if SHIELD_ANYWHY_FLAKE_CENTRAL_DONGLE

config ZMK_KEYBOARD_NAME
    default "Flake Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_STUDIO
    default y

endif

# ---------- split enabled for every variant ----------
if SHIELD_ANYWHY_FLAKE_LEFT || SHIELD_ANYWHY_FLAKE_RIGHT || \
   SHIELD_ANYWHY_FLAKE_CENTRAL_DONGLE || SHIELD_ANYWHY_FLAKE_PERIPHERAL_LEFT || \
   SHIELD_ANYWHY_FLAKE_PERIPHERAL_RIGHT

config ZMK_SPLIT
    default y

endif

# ---------- OLED on the dongle ----------
if SHIELD_ANYWHY_FLAKE_CENTRAL_DONGLE

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # ZMK_DISPLAY

if SSD1306

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # SSD1306

endif # SHIELD_ANYWHY_FLAKE_CENTRAL_DONGLE
